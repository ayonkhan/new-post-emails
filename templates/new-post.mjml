<mjml>
    <mj-head>
        <mj-title>%%title%%</mj-title>
        <mj-preview>%%description%%</mj-preview>
        <mj-attributes>
            <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
            <mj-text font-size="16px" line-height="1.6" color="#1e1e1e" />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#eeeff1">
        <!-- Leaves a strip of background above the card -->
        <mj-wrapper padding="32px 0 0">
        <mj-section background-color="#ffffff" border-radius="8px" padding="32px 24px">
            <mj-column>
                <mj-text font-size="20px" font-weight="700">
                    <a href="https://www.ayonkhan.ca/" style="color: #1e1e1e; text-decoration: none;">ayonkhan.ca</a>
                </mj-text>
                <mj-text font-size="13px" color="#5f5f5f" padding-bottom="0">New post · %%date%%</mj-text>
                <mj-text font-size="22px" font-weight="700" line-height="1.3">%%title%%</mj-text>
                <mj-text color="#4a4a4a">%%description%%</mj-text>
                <mj-button href="%%link%%" align="left" background-color="#1e1e1e" color="#ffffff" border-radius="8px">
                    Read the post
                </mj-button>
            </mj-column>
        </mj-section>
        </mj-wrapper>
        <mj-section padding="16px 24px">
            <mj-column>
                <mj-text align="center" font-size="13px" color="#5f5f5f">
                    You're getting this because you subscribed to new posts on ayonkhan.ca.<br />
                    <a href="{{{RESEND_UNSUBSCRIBE_URL}}}" style="color: #5f5f5f;">Unsubscribe</a>
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
