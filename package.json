{
    "name": "paperboy",
    "private": true,
    "description": "Emails your subscribers when a new post appears in your RSS feed, using Resend",
    "type": "module",
    "scripts": {
        "build": "mjml templates/new-post.mjml -o templates/new-post.html",
        "dev": "wrangler dev --test-scheduled",
        "deploy": "wrangler deploy",
        "test": "npm run build && node --import ./tests/register.mjs --test"
    },
    "devDependencies": {
        "mjml": "^4.15.3",
        "wrangler": "^4.0.0"
    }
}
